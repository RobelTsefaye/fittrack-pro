# ── Database ─────────────────────────────────────────────
# For local dev (Prisma local server):
#   DATABASE_URL="prisma+postgres://localhost:51213/?api_key=..."
#   DIRECT_DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1"
#
# For production (Neon / Supabase / any cloud Postgres):
#   DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DATABASE_URL=""

# Direct connection (bypasses Prisma proxy, used for migrations + seed)
# In production with Neon, use the same URL as DATABASE_URL.
# TAKES PRECEDENCE over DATABASE_URL at runtime (src/lib/prisma.ts): when rotating the database
# password, change BOTH variables (see project-docs/deployment.md, "Rotation").
DIRECT_DATABASE_URL=""

# ── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Required by NextAuth v5 — the public address the app is served from
# e.g. https://<mac>.<tailnet>.ts.net (selfhost) or https://fittrack.vercel.app
AUTH_URL=""

# Behind a proxy / Tailscale Funnel (selfhost): set to true (Vercel sets it implicitly)
# AUTH_TRUST_HOST=true

# ── AI Coach ─────────────────────────────────────────────
# Free tier — get your key at https://aistudio.google.com (no credit card needed)
# Needed by the in-app chat endpoint (/api/chat); no UI caller at the moment.
GOOGLE_GENERATIVE_AI_API_KEY=""

# ── App ──────────────────────────────────────────────────
# Same URL you open in the browser (Mac + phone). Shown in Settings for
# “use on every device”. Production: https://your-app.vercel.app
# Local LAN phone testing: http://192.168.x.x:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Registration ─────────────────────────────────────────
# "closed" (default): POST /api/auth/register answers 403 and /register shows a notice,
# EXCEPT while the database has no user yet (first setup of a new instance).
# "open": anyone can sign up (only for a deliberately public instance).
FITTRACK_REGISTRATION="closed"

# ── Optional ─────────────────────────────────────────────
# Base address the native iOS app calls (baked into the build; default in src/lib/constants.ts).
# NEXT_PUBLIC_API_ORIGIN=""
# Selfhost port (scripts/selfhost.sh), default 3005.
# FITTRACK_PORT="3005"
# MCP server (mcp/fittrack-mcp) and `npm run demo:ai` only, not read by the web app:
# FITTRACK_BASE_URL="http://localhost:3000"
# FITTRACK_API_TOKEN=""   # ftp_... token from Settings; never commit a value
